# Supabase connection string.
# Dashboard → Project Settings → Database → Connection string → Session pooler.
# The direct `db.[project-ref].supabase.co` host is IPv6-only on new projects —
# use the pooler host, which is what the previous working config used.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

DAPI_KEY=your_api_key_here

# CData Connect Cloud (PlatformDB / MongoDB access)
CDATA_HOST=
CDATA_PORT=
CDATA_USER=
CDATA_PAT=
CDATA_DATABASE=
